# ==============================================================================
# CAT Operator Copilot - Backend Configuration & Secrets Template (.env.example)
# ==============================================================================

# Application & Environment
ENVIRONMENT=development
DEBUG=true

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# Security & Secrets
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
API_KEY=cat-operator-internal-api-key-secret

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3005,http://127.0.0.1:3005

# Local AI Copilot (Ollama LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=8.0

# Deterministic Machine Safety Envelope Thresholds (Meters)
SAFETY_CRITICAL_DISTANCE_METERS=3.0
SAFETY_HIGH_DISTANCE_METERS=5.0
SAFETY_WARNING_DISTANCE_METERS=10.0

# Machinery Kinematic & Physics Limiters
MAX_HYDRAULIC_PRESSURE_BAR=350.0
MAX_ROLL_ANGLE_DEG=15.0
MAX_PERCLOS_FATIGUE=0.35

# Default Machine & Operator IDs
DEFAULT_MACHINE_ID=EXC-320-CAT-09
DEFAULT_OPERATOR_ID=OP-RAJ-4492
